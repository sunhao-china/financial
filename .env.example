# ==== 必需 ====
DEEPSEEK_API_KEY=sk-xxxxxxxx          # DeepSeek 生成 API（对话/意图/验证均走它）
MYSQL_PASSWORD=your-mysql-password    # 本地 MySQL fin 用户密码（启动自动建表）
FIN_ADMIN_PASSWORD=change-me          # 首次启动自动创建 admin 账号的密码

# ==== 可选（均有默认值，完整清单见 config.py）====
# DASHSCOPE_API_KEY=sk-xxxxxxxx       # 阿里云百炼（备用/早期评测用）
# API_HOST=0.0.0.0
# API_PORT=8001
# REDIS_URL=redis://127.0.0.1:6379/0
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=fin
# MYSQL_DB=fin
# LANGFUSE_ENABLED=0                  # 1 时需配 LANGFUSE_PUBLIC_KEY/SECRET_KEY（host 默认 us.cloud.langfuse.com）
# FIN_TOKEN_SECRET=随机串              # 不设则自动生成 .token_secret 文件（防重启失效）
# 安全参数（默认值）：FIN_LOCKOUT_MAX_FAIL=5 / FIN_LOCKOUT_SEC=86400 /
#   FIN_IP_FAIL_LIMIT=30 / FIN_IP_WINDOW_SEC=900 / FIN_IP_BLOCK_SEC=900 /
#   FIN_CAPTCHA_IP_LIMIT=20 / FIN_PBKDF2_ROUNDS=310000 / FIN_PASSWORD_MIN_LEN=8 / FIN_CAPTCHA_LEN=5
