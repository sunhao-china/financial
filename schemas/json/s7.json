          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent"
    },
    "entities": {
      "items": {
        "type": "string"
      },
      "title": "Entities",
      "type": "array"
    },
    "queries": {
      "items": {
        "type": "string"
      },
      "title": "Queries",
      "type": "array"
    },
    "keywords": {
      "items": {
        "type": "string"
      },
      "title": "Keywords",
      "type": "array"
    },
    "retrieval": {
      "items": {
        "$ref": "#/$defs/S7RetrievalRound"
      },
      "title": "Retrieval",
      "type": "array"
    },
    "self_check": {
      "anyOf": [
        {
          "$ref": "#/$defs/S7SelfCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/S7Verification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "answer": {
      "default": "",
      "title": "Answer",
      "type": "string"
    },
    "citations": {
      "items": {
        "type": "string"
      },
      "title": "Citations",
      "type": "array"
    },
    "timings_ms": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Timings Ms",
      "type": "object"
    },
    "cost_tokens": {
      "$ref": "#/$defs/S7Cost"
    }
  },
  "required": [
    "query_id",
    "session_id",
    "question"
  ],
  "title": "S7Snapshot",
  "type": "object"
