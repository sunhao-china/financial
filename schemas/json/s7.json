      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "intent": {
      "anyOf": [
        {
          "enum": [
            "fact_qa",
            "analysis",
            "comparison",
            "realtime",
            "investment_advice",
            "chitchat"
