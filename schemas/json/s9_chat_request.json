{
  "$defs": {
    "Message": {
      "description": "通用对话消息（S6 history / S9 请求）。",
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant",
            "system"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    }
  },
  "description": "S9：POST /chat 请求体（§14）。",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "question"
  ],
  "title": "S9ChatRequest",
  "type": "object"
}