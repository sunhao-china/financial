{
  "$defs": {
    "S1Metadata": {
      "description": "S1 metadata：溯源与版本字段（§8）。",
      "properties": {
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "industry_type": {
          "title": "Industry Type",
          "type": "string"
        },
        "quality_score": {
          "title": "Quality Score",
          "type": "number"
        },
        "perplexity": {
          "title": "Perplexity",
          "type": "number"
        },
        "num_words": {
          "title": "Num Words",
          "type": "integer"
        },
        "chunk_index": {
          "title": "Chunk Index",
          "type": "integer"
        },
        "chunk_count": {
          "title": "Chunk Count",
          "type": "integer"
        },
        "char_start": {
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "title": "Char End",
          "type": "integer"
        },
        "chunking_method": {
          "title": "Chunking Method",
          "type": "string"
        },
        "chunking_version": {
          "default": "v1.0",
          "title": "Chunking Version",
          "type": "string"
        },
        "embedding_model": {
          "default": "text-embedding-v3",
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_dim": {
          "default": 1024,
          "title": "Embedding Dim",
          "type": "integer"
        },
        "data_version": {
          "title": "Data Version",
          "type": "string"
        },
        "ingested_at": {
          "title": "Ingested At",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "source_file",
        "industry_type",
        "quality_score",
        "perplexity",
        "num_words",
        "chunk_index",
        "chunk_count",
        "char_start",
        "char_end",
        "chunking_method",
        "data_version",
        "ingested_at"
      ],
      "title": "S1Metadata",
      "type": "object"
    }
  },
  "description": "S1：向量库入库记录，一 chunk 一条（§8）。",
  "properties": {
    "id": {
      "description": "唯一 chunk id：{source_file}_{doc_id}_c{chunk_index}",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "text": {
      "description": "chunk 原文片段（即转向量前的文本）",
      "title": "Text",
      "type": "string"
    },
    "embedding": {
      "description": "向量，写入向量库前生成",
      "items": {
        "type": "number"
      },
      "title": "Embedding",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/S1Metadata"
    }
  },
  "required": [
    "id",
    "text",
    "embedding",
    "metadata"
  ],
  "title": "S1Record",
  "type": "object"
}